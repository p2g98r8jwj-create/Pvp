local World = { xrayOrig = setmetatable({}, { __mode = "k" }), xrayConns = {}, xrayGen = 0, fpsConn = nil }
local XRAY_ALPHA = 0.6
local XRAY_FOLDERS = { "Base", "PlotSign", "FriendPanel", "Cash", "Laser", "Decorations", "Skin", "Unlock", "Purchases" }

function World.xrayPaint(o, a)
    if not o or not o:IsA("BasePart") then return end
    if World.xrayOrig[o] == nil then World.xrayOrig[o] = (o.Transparency == a) and 0 or o.Transparency end
    local base = World.xrayOrig[o]
    if type(base) == "number" and base < 1 then
        local want = base + (1 - base) * a
        if math.abs(o.Transparency - want) > 0.01 then o.Transparency = want end
    end
end

function World.xrayTrack(root, a, id)
    if not root or id ~= World.xrayGen then return end
    World.xrayPaint(root, a)
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        if id ~= World.xrayGen then return end
        World.xrayPaint(d, a)
        n = n + 1
        if n % 250 == 0 then task.wait() end
    end
    World.xrayConns[#World.xrayConns + 1] = root.DescendantAdded:Connect(function(d)
        if id == World.xrayGen then World.xrayPaint(d, a) end
    end)
end

function World.xrayPlot(plot, a, id)
    if not plot or id ~= World.xrayGen then return end
    for _, fname in ipairs(XRAY_FOLDERS) do
        if id ~= World.xrayGen then return end
        World.xrayTrack(plot:FindFirstChild(fname), a, id)
    end
    local pods = plot:FindFirstChild("AnimalPodiums")
    if not pods then return end
    for _, pd in ipairs(pods:GetChildren()) do
        for _, c in ipairs(pd:GetChildren()) do
            if c.Name == "Claim" then
                World.xrayTrack(c, a, id)
            elseif c.Name == "Base" then
                World.xrayTrack(c:FindFirstChild("Decorations"), a, id)
            elseif c:IsA("Model") then
                World.xrayTrack(c, a, id)
            end
        end
    end
end

function World.xrayDisable()
    World.xrayGen = World.xrayGen + 1
    for _, c in ipairs(World.xrayConns) do pcall(function() c:Disconnect() end) end
    World.xrayConns = {}
end

function World.xrayEnable()
    World.xrayDisable()
    local id = World.xrayGen
    local a = math.clamp(XRAY_ALPHA, 0, 1)
    task.spawn(function()
        while id == World.xrayGen and not Workspace:FindFirstChild("Plots") do task.wait(0.5) end
        local plots = Workspace:FindFirstChild("Plots")
        if id ~= World.xrayGen or not plots then return end
        for _, p in ipairs(plots:GetChildren()) do
            if id ~= World.xrayGen then return end
            pcall(World.xrayPlot, p, a, id)
            task.wait()
        end
    end)
end

local function stripPreserve(obj)
    local node = obj
    while node and node ~= Workspace do
        local nm = node.Name
        if type(nm) == "string" and (nm:find("ESP") or nm:find("Sertix") or nm:find("Brainrot")) then return true end
        node = node.Parent
    end
    return false
end

local function stripVisuals(obj)
    if stripPreserve(obj) or obj:IsA("Highlight") then return end
    local model = obj:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then return end
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        pcall(function() obj.Enabled = false end)
    elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        pcall(function() obj.Enabled = false end)
    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        pcall(function() obj.Transparency = 1 end)
    elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
        pcall(function()
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        end)
    end
end

