function Aim.hookChar(ch)
    for _, c in ipairs(ch:GetChildren()) do Aim.hookTool(c) end
    table.insert(Aim.conns, ch.ChildAdded:Connect(Aim.hookTool))
end

function Aim.stop()
    for _, c in ipairs(Aim.conns) do pcall(function() c:Disconnect() end) end
    Aim.conns = {}
    Aim.hooked = setmetatable({}, { __mode = "k" })
end

function Aim.start()
    Aim.stop()
    task.spawn(Aim.scan)
    if LocalPlayer.Character then Aim.hookChar(LocalPlayer.Character) end
    table.insert(Aim.conns, LocalPlayer.CharacterAdded:Connect(function(ch)
        task.wait(0.5)
