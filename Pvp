local function scanBrainrots()
    local results = {}
    local plotsFolder = Workspace:FindFirstChild("Plots")
    if not plotsFolder then return results end
    MyBaseSide = getMyBaseSide() or MyBaseSide
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if not isMyPlot(plot) then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local slotNumber = tonumber(podium.Name:match("%d+")) or 1
                    local base = podium:FindFirstChild("Base") or podium
                    local spawnPoint = base:FindFirstChild("Spawn")
                    local attachment = spawnPoint and spawnPoint:FindFirstChild("PromptAttachment")
                    if attachment and not (MyBaseSide == "b2" and slotNumber == 28) then
                        for _, prompt in ipairs(attachment:GetChildren()) do
                            if prompt:IsA("ProximityPrompt") and isValidStealPrompt(prompt) then
                                table.insert(results, {
                                    key = plot.Name .. "_" .. slotNumber, prompt = prompt, slot = slotNumber,
                                    name = prompt.ObjectText or "Pet", plot = plot, spawnPoint = spawnPoint,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(results, function(a, b) return a.slot < b.slot end)
    return results
end

