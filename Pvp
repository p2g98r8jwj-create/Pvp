local NetBridge = { queue = {}, hooked = false, host = nil, orig = nil, mod = nil, cache = {} }

function NetBridge.module()
    if NetBridge.mod then return NetBridge.mod end
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    local netMod = pk and pk:FindFirstChild("Net")
    if not netMod then return nil end
    local ok, m = pcall(require, netMod)
    if ok and type(m) == "table" then NetBridge.mod = m end
    return NetBridge.mod
end

function NetBridge.findHost()
    if type(getconnections) ~= "function" or type(islclosure) ~= "function" then return nil end
    for _, sig in ipairs({ RunService.Heartbeat, RunService.RenderStepped, RunService.PostSimulation }) do
        local ok, list = pcall(getconnections, sig)
        if ok and type(list) == "table" then
            for _, c in ipairs(list) do
                local fn = c.Function
                if type(fn) == "function" and islclosure(fn)
                    and (type(isexecutorclosure) ~= "function" or not isexecutorclosure(fn)) then
                    local ok2, src = pcall(debug.info, fn, "s")
                    if ok2 and type(src) == "string" and src:find("^ReplicatedStorage%.") and not src:find("ReplicatedFirst") then
                        return fn
                    end
                end
            end
        end
    end
    return nil
end

function NetBridge.install()
    if NetBridge.hooked then return true end
    if type(hookfunction) ~= "function" then return false end
    local mod = NetBridge.module()
    if not mod then return false end
    local host = NetBridge.findHost()
    if not host then return false end
    local orig
    local function wrapper(...)
        local job = table.remove(NetBridge.queue, 1)
        if job then
            local ok, res = pcall(mod[job.kind], mod, job.name)
            job.result = (ok and typeof(res) == "Instance") and res or nil
            job.done = true
        end
        return orig(...)
    end
    local okEnv, env = pcall(getfenv, host)
    if okEnv and type(env) == "table" then pcall(setfenv, wrapper, env) end
    orig = hookfunction(host, wrapper)
    NetBridge.host, NetBridge.orig, NetBridge.hooked = host, orig, true
    return true
end

function NetBridge.uninstall()
    if NetBridge.hooked and NetBridge.host and NetBridge.orig then
        pcall(hookfunction, NetBridge.host, NetBridge.orig)
    end
    NetBridge.hooked = false
    NetBridge.queue = {}
end

function NetBridge.get(name)
    local cached = NetBridge.cache[name]
    if cached and cached.Parent then return cached end
    if not NetBridge.install() then return nil end
    local job = { kind = "RemoteEvent", name = name, done = false }
    table.insert(NetBridge.queue, job)
    local deadline = os.clock() + 5
    while not job.done and not thisScriptStopped and os.clock() < deadline do
        RunService.Heartbeat:Wait()
    end
    if not job.done then
        for i = #NetBridge.queue, 1, -1 do
            if NetBridge.queue[i] == job then table.remove(NetBridge.queue, i) end
        end
    end
    NetBridge.uninstall()
    if job.result and job.result.Parent then
        NetBridge.cache[name] = job.result
        return job.result
    end
    return nil
end

