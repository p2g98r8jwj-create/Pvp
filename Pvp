local function isPointer(inp)
    return inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch
end

local function isMove(inp)
    return inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch
end

local function makeDraggable(handle, target, saveKey)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(inp)
        if _G.UILocked then return end
        if isPointer(inp) then
            dragging = true
            dragStart = inp.Position
            startPos = target.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(inp)
        if not dragging or not isMove(inp) then return end
        local d = inp.Position - dragStart
        target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end))
    track(UserInputService.InputEnded:Connect(function(inp)
        if not isPointer(inp) then return end
        if dragging and saveKey then savePosition(saveKey, target.Position) end
        dragging = false
    end))
end

local function makeResizable(handle, target, saveKey)
    local resizing, resizeStart, startSize = false, nil, nil
    handle.InputBegan:Connect(function(inp)
        if _G.UILocked then return end
        if isPointer(inp) then
            resizing = true
            resizeStart = inp.Position
            startSize = target.AbsoluteSize
        end
    end)
    track(UserInputService.InputChanged:Connect(function(inp)
        if not resizing or not isMove(inp) then return end
        local d = inp.Position - resizeStart
        local newW = math.max(200, startSize.X + d.X)
        local newH = math.max(180, startSize.Y + d.Y)
        target.Size = UDim2.new(0, newW, 0, newH)
    end))
    track(UserInputService.InputEnded:Connect(function(inp)
        if not isPointer(inp) then return end
        if resizing and saveKey then saveSize(saveKey, target.Size) end
        resizing = false
    end))
end

