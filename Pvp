local QuickPickup = { enabled = false, orig = {}, hooked = false, addConn = nil }

local function inMyPlot(inst)
    if not inst or not inst.Parent then return false end
    local node = inst.Parent
    for _ = 1, 10 do
        if not node then return false end
        if node:IsA("Model") and node.Parent and node.Parent.Name == "Plots" then
            return isMyPlot(node)
        end
        node = node.Parent
    end
    return false
end

function QuickPickup.installHook()
    if QuickPickup.hooked then return end
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    if not pcall(setreadonly, mt, false) then return end
    local old = mt.__newindex
    local nc = newcclosure or function(f) return f end
    mt.__newindex = nc(function(self, key, value)
        if not thisScriptStopped and key == "HoldDuration" and QuickPickup.enabled
            and typeof(self) == "Instance" and self:IsA("ProximityPrompt") and inMyPlot(self) then
            value = 0.1
        end
        return old(self, key, value)
    end)
    pcall(setreadonly, mt, true)
    QuickPickup.hooked = true
end

function QuickPickup.set(v)
    QuickPickup.enabled = v
    if v then
        QuickPickup.installHook()
        task.spawn(function()
            local root = Workspace:FindFirstChild("Plots") or Workspace
            local stack, si = { root }, 1
            while si > 0 do
                if not QuickPickup.enabled then return end
                local cur = stack[si]
                stack[si] = nil
                si = si - 1
                for _, d in ipairs(cur:GetChildren()) do
                    if d:IsA("ProximityPrompt") and inMyPlot(d) then
                        if QuickPickup.orig[d] == nil then QuickPickup.orig[d] = d.HoldDuration end
                        pcall(function() d.HoldDuration = 0.1 end)
                    end
                    si = si + 1
                    stack[si] = d
                end
            end
        end)
    else
        for p, o in pairs(QuickPickup.orig) do
            if p and p.Parent then pcall(function() p.HoldDuration = o end) end
        end
        QuickPickup.orig = {}
    end
end

local Glass = { Lights = {}, LightSource = Vector2.new(0.14, -0.32) }
Glass.white = Color3.new(1, 1, 1)
Glass.black = Color3.new(0, 0, 0)

function Glass.kp(t, v)
    return NumberSequenceKeypoint.new(t, v)
end

Glass.edgeSeq = NumberSequence.new({
    Glass.kp(0, 0.22), Glass.kp(0.28, 0.58), Glass.kp(0.55, 0.9), Glass.kp(0.82, 0.93), Glass.kp(1, 0.76),
})

function Glass.register(gradient, gui, offset)
    Glass.Lights[gradient] = { Gui = gui, Offset = offset or 0 }
end

function Glass.update()
    if next(Glass.Lights) == nil then return end
    local cam = Workspace.CurrentCamera
    local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local light = viewport * Glass.LightSource
    for gradient, entry in pairs(Glass.Lights) do
        local gui = entry.Gui
        if not gradient.Parent or not gui.Parent then
            Glass.Lights[gradient] = nil
        elseif gradient.Enabled then
            local center = gui.AbsolutePosition + gui.AbsoluteSize / 2
            local d = light - center
            gradient.Rotation = math.deg(math.atan2(-d.Y, -d.X)) + entry.Offset
        end
    end
end

function Glass.edge(parent, transparency, thickness)
    local st = new("UIStroke", {
        Name = "GlassEdge", Color = Glass.white, Thickness = thickness or 1, Transparency = transparency or 0.4,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
    local g = new("UIGradient", { Transparency = Glass.edgeSeq, Rotation = 135 }, st)
    Glass.register(g, parent)
    return st
end

function Glass.sheen(parent, radius, strength)
    strength = strength or 0.06
    local f = new("Frame", {
        Name = "GlassSheen", BorderSizePixel = 0, BackgroundColor3 = Glass.white, Size = UDim2.fromScale(1, 1), ZIndex = 0,
    }, parent)
    corner(f, radius)
    local g = new("UIGradient", {
        Transparency = NumberSequence.new({
            Glass.kp(0, 1 - strength), Glass.kp(0.35, 1 - strength * 0.35), Glass.kp(0.7, 1), Glass.kp(1, 1),
        }),
    }, f)
    Glass.register(g, parent)
    return f
end

function Glass.wash(parent, radius, color)
    local f = new("Frame", {
        Name = "GlassWash", BorderSizePixel = 0, BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), ZIndex = 0,
    }, parent)
    corner(f, radius)
    new("UIGradient", {
        Rotation = 35,
        Transparency = NumberSequence.new({ Glass.kp(0, 0.9), Glass.kp(0.45, 0.97), Glass.kp(1, 1) }),
    }, f)
    return f
end

function Glass.shadow(parent, spread, offsetY, transparency)
    return new("ImageLabel", {
        Name = "GlassShadow", BackgroundTransparency = 1, BorderSizePixel = 0, Image = "rbxassetid://6014261993",
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ImageColor3 = Glass.black,
        ImageTransparency = transparency or 0.45, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, offsetY or 14), Size = UDim2.new(1, spread or 80, 1, spread or 80), ZIndex = 0,
    }, parent)
end

function Glass.sweep(parent, radius, duration)
    local holder = new("Frame", {
        Name = "GlassSweep", BorderSizePixel = 0, BackgroundColor3 = Glass.white, BackgroundTransparency = 0,
        Size = UDim2.fromScale(1, 1), ZIndex = 40,
    }, parent)
    corner(holder, radius)
    local st = new("UIStroke", { Color = Glass.white, Thickness = 1.25, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, holder)
    local function band(peak)
        return NumberSequence.new({ Glass.kp(0, 1), Glass.kp(0.3, 1), Glass.kp(0.5, peak), Glass.kp(0.7, 1), Glass.kp(1, 1) })
    end
    local sg = new("UIGradient", { Transparency = band(0.6), Rotation = 115 }, st)
    local fg = new("UIGradient", { Transparency = band(0.975), Rotation = 115 }, holder)
    local dir = Vector2.new(math.cos(math.rad(115)), math.sin(math.rad(115)))
    local progress = new("NumberValue", {})
    local tw = TweenService:Create(progress, TweenInfo.new(duration or 1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = 1 })
    progress.Changed:Connect(function(a)
        local off = dir * (-1.1 + 2.2 * a)
        sg.Offset = off
        fg.Offset = off
    end)
    tw.Completed:Connect(function()
        holder:Destroy()
        progress:Destroy()
    end)
    tw:Play()
end

function Glass.set(t, on, withSweep)
    if on then
        if not t.layers then
            t.layers = {
                shadow = Glass.shadow(t.parent, 70, 14, 0.5),
                sheen = Glass.sheen(t.main, t.radius, 0.07),
                wash = Glass.wash(t.main, t.radius, Color3.fromRGB(170, 172, 180)),
                edge = Glass.edge(t.main, 0.35, 1.2),
            }
        end
        if not t.captured then
            t.captured = true
            t.baseTrans = t.main.BackgroundTransparency
            t.baseStroke = t.stroke.Transparency
        end
        t.layers.shadow.Visible = true
        t.layers.sheen.Visible = true
        t.layers.wash.Visible = true
        t.layers.edge.Enabled = true
        t.main.BackgroundTransparency = math.max(t.baseTrans, 0.2)
        t.stroke.Transparency = 1
        if t.glow then t.glow.Visible = false end
        if withSweep then Glass.sweep(t.main, t.radius, 1.6) end
    elseif t.layers then
        t.layers.shadow.Visible = false
        t.layers.sheen.Visible = false
        t.layers.wash.Visible = false
        t.layers.edge.Enabled = false
        t.main.BackgroundTransparency = t.baseTrans
        t.stroke.Transparency = t.baseStroke
        if t.glow then t.glow.Visible = true end
    end
end

