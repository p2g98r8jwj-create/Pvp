    local lastSig = ""
    local rowFrames = {}
    local function genOf(rec)
        local plotName = rec.plot and rec.plot.Name
        for _, d in ipairs(Shared.AllAnimalsCache) do
            if d.plot == plotName and d.slot == rec.slot and d.genText then
                return (tostring(d.genText):gsub("^%s*%$", ""):gsub("%.00", ""))
            end
        end
        return nil
    end
    local function makeChip(parent, text, textColor, order)
        local f = new("Frame", {
            Size = UDim2.new(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = P.panel,
            BorderSizePixel = 0, LayoutOrder = order, ZIndex = 16,
        }, parent)
        corner(f, 5)
        stroke(f, P.lineDim, 1, 0.35)
        new("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, f)
        local l = new("TextLabel", {
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
            Text = text, TextColor3 = textColor, TextSize = 10, Font = Enum.Font.GothamBold, ZIndex = 17,
        }, f)
        return f, l
    end
    local function rebuildBrainrots(results)
        local parts = {}
        for _, r in ipairs(results) do parts[#parts + 1] = r.name .. "_" .. r.slot .. "_" .. r.key end
        table.sort(parts)
        local sig = table.concat(parts, "|")
        for _, v in pairs(BrainrotList.views) do
            if v.genLbl and v.rec then
                local g = genOf(v.rec)
                if g and v.genLbl.Text ~= g then v.genLbl.Text = g end
            end
        end
        if sig == lastSig then return end
        lastSig = sig

        for _, f in pairs(rowFrames) do pcall(function() f:Destroy() end) end
        rowFrames = {}
        BrainrotList.views = {}
        brEmpty.Visible = (#results == 0)

        for i, rec in ipairs(results) do
            local rowOk, rowErr = pcall(function()
            local row = new("Frame", {
                Size = UDim2.new(1, 0, 0, 68), BackgroundColor3 = P.card, BorderSizePixel = 0,
                LayoutOrder = i, ZIndex = 15,
            }, brScroll)
            corner(row, 10)
            new("UIGradient", {
                Rotation = 90,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 190, 196)),
                }),
            }, row)
            local rs = stroke(row, P.lineDim, 1, 0.45)

            makeViewport(row, 52, rec.name, UDim2.new(0, 8, 0.5, -26))

            local nameLbl = new("TextLabel", {
                Size = UDim2.new(1, -96, 0, 18), Position = UDim2.new(0, 70, 0, 11), BackgroundTransparency = 1,
                Text = rec.name, TextColor3 = P.white, TextSize = 13, Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 16,
            }, row)

            local chips = new("Frame", {
                Size = UDim2.new(1, -78, 0, 18), Position = UDim2.new(0, 70, 0, 38), BackgroundTransparency = 1, ZIndex = 16,
            }, row)
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5),
                SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
            }, chips)
            local _, genLbl = makeChip(chips, (genOf(rec) or "--"), P.white, 1)
            makeChip(chips, "Slot " .. tostring(rec.slot), P.dim, 2)

            local dot = new("Frame", {
                Size = UDim2.new(0, 9, 0, 9), Position = UDim2.new(1, -20, 0, 11), BackgroundColor3 = P.green,
                BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 17,
            }, row)
            corner(dot, 5)

            local click = new("TextButton", {
                Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 15,
            }, row)
            click.MouseButton1Click:Connect(function() selectBrainrot(rec.key) end)

            rowFrames[rec.key] = row
            BrainrotList.views[rec.key] = {
                row = row, rec = rec, genLbl = genLbl,
                paint = function()
                    local sel = rec.key == BrainrotList.selectedKey
                    tween(row, 0.18, { BackgroundColor3 = sel and P.cardHi or P.card })
                    tween(rs, 0.18, { Color = sel and P.dim or P.lineDim, Thickness = sel and 1.6 or 1, Transparency = sel and 0.1 or 0.45 })
                    tween(dot, 0.18, { BackgroundTransparency = sel and 0 or 1 })
                end,
