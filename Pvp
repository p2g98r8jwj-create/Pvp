            end
            table.sort(list, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
            qapEmpty.Visible = (#list == 0)
            for i, plr in ipairs(list) do
                qapRows[#qapRows + 1] = qapMakeRow(plr, i)
            end
        end)
    end
