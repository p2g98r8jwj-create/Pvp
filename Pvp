do
    local EQUIP_SPEED = 175
    local wasEquipped = false
    track(RunService.Heartbeat:Connect(function()
        if thisScriptStopped then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        local equipped = false
        if _G.AutoSpeedEquip and not Sel.auto then
            local tool = getSelectedGearTool()
            equipped = tool ~= nil and tool.Parent == char
        end
        if equipped then
            wasEquipped = true
            hrp.AssemblyAngularVelocity = Vector3.zero
            local dir = hum.MoveDirection
            local vel = hrp.AssemblyLinearVelocity
            if dir.Magnitude > 0.05 then
                hrp.AssemblyLinearVelocity = Vector3.new(dir.X * EQUIP_SPEED, vel.Y, dir.Z * EQUIP_SPEED)
            else
                hrp.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
            end
        elseif wasEquipped then
            wasEquipped = false
            local vel = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
        end
    end))
end

local joinLock = false

local function shutdown()
    if thisScriptStopped then return end
    thisScriptStopped = true
    Aim.enabled = false
    pcall(Aim.stop)
    pcall(NetBridge.uninstall)
    pcall(Guard.stopRagdoll)
    pcall(Guard.stopJump)
    pcall(World.xrayDisable)
    pcall(World.fpsDisable)
    pcall(function() QuickPickup.set(false) end)
    for _, st in pairs(Watch) do
        st.Enabled = false
        pcall(stopWatcher, st)
    end
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    Conns = {}
    for uid in pairs(Esp.cards) do destroyEntry(Esp.cards, uid) end
    for plr in pairs(Esp.players) do Esp.clearPlayer(plr) end
    for plr, hl in pairs(Esp.steal) do
        pcall(function() hl:Destroy() end)
        Esp.steal[plr] = nil
    end
    for k, v in pairs(Esp.timers) do
        pcall(function() v:Destroy() end)
        Esp.timers[k] = nil
    end
    pcall(Esp.clearBadges)
    pcall(Esp.clearPackIcons)
    for _, inst in ipairs({ Esp.bestBeam, Esp.bestA0, Esp.bestA1, Esp.baseBeam, Esp.baseA0, Esp.baseA1 }) do
        pcall(function() inst:Destroy() end)
    end
    clearSelectionHL()
    pcall(forceUnlockEverything)
    pcall(function() settings().Network.IncomingReplicationLag = 0 end)
    pcall(function() if hubGui then hubGui:Destroy() end end)
    pcall(function() if fabGui then fabGui:Destroy() end end)
    pcall(function() if hubRefs.actionFloating then hubRefs.actionFloating:Destroy() end end)
    pcall(function() if hubRefs.autoToggleBanner then hubRefs.autoToggleBanner:Destroy() end end)
    pcall(function() if AutoGrabUI.container then AutoGrabUI.container.Parent:Destroy() end end)
    _G.SertixPVPShutdown = nil
end
_G.SertixPVPShutdown = shutdown

