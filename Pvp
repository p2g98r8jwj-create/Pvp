local function resolveFullName(raw)
    if not raw or raw == "" then return tostring(raw or "") end
    local s = tostring(raw):gsub("%.+$", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if AnimalsData and AnimalsData[s] then return s end
    local low = s:lower()
    if AnimalsData then
        for name in pairs(AnimalsData) do
            if type(name) == "string" and name:lower() == low then return name end
        end
        if #low >= 3 then
            local best, bl = nil, 0
            for name in pairs(AnimalsData) do
                if type(name) == "string" then
                    local nl = name:lower()
                    if nl:sub(1, #low) == low and #name > bl then best, bl = name, #name end
                end
            end
            if best then return best end
        end
    end
    return s
end

local function putModelInVP(vp, template)
    if not (vp and template) then return false end
    local saved = {}
    local function forceArch(obj)
        if obj.Archivable == false then
            saved[#saved + 1] = obj
            obj.Archivable = true
        end
    end
    pcall(function()
        forceArch(template)
        for _, d in ipairs(template:GetDescendants()) do forceArch(d) end
    end)
    local ok, clone = pcall(function() return template:Clone() end)
    for _, o in ipairs(saved) do pcall(function() o.Archivable = false end) end
    if not ok or not clone then return false end
    for _, c in ipairs(vp:GetChildren()) do pcall(function() c:Destroy() end) end
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript")
            or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("BillboardGui")
            or d:IsA("ProximityPrompt") or d:IsA("Highlight") then
            pcall(function() d:Destroy() end)
        end
    end
    local world = Instance.new("WorldModel")
    world.Parent = vp
    clone.Parent = world
    local cam = Instance.new("Camera")
    cam.Parent = vp
    vp.CurrentCamera = cam
    vp.Ambient = Color3.fromRGB(200, 200, 200)
    vp.LightColor = Color3.fromRGB(255, 255, 255)
    vp.LightDirection = Vector3.new(-0.35, -1, -0.45)
    task.spawn(function()
        local ang = 0
        while vp.Parent and clone.Parent and not thisScriptStopped do
            ang = ang + 0.04
            pcall(function()
                local bcf, bsz = clone:GetBoundingBox()
                local c = bcf.Position
                local dist = math.max(bsz.X, bsz.Y, bsz.Z, 0.5) * 2.1
                cam.CFrame = CFrame.new(c + Vector3.new(math.sin(ang) * dist, dist * 0.42, math.cos(ang) * dist), c)
            end)
            task.wait(0.03)
        end
    end)
    return true
end

local function findModelTemplate(full)
    if ModelsAnimals then
        local t = ModelsAnimals:FindFirstChild(full)
        if t then return t end
        local low = full:lower()
        for _, ch in ipairs(ModelsAnimals:GetChildren()) do
            if ch.Name:lower() == low then return ch end
        end
        if #full >= 4 then
            for _, ch in ipairs(ModelsAnimals:GetChildren()) do
                if ch.Name:lower():find(low, 1, true) then return ch end
            end
        end
    end
    for _, folder in ipairs(ModelFolders) do
        local t = folder:FindFirstChild(full)
        if t then return t end
        local low = full:lower()
        for _, ch in ipairs(folder:GetChildren()) do
            if ch.Name:lower() == low then return ch end
        end
    end
    return nil
end

local function fillViewport(vp, animalName)
    if not vp or not animalName or animalName == "" then return false end
    local full = resolveFullName(animalName)
    if SharedAnimals then
        local tries = {
            function() SharedAnimals:AttachOnViewportWithOptimizations(full, vp, "None", nil) end,
            function() SharedAnimals:AttachOnViewportWithOptimizations(full, vp, "None") end,
            function() SharedAnimals:AttachOnViewportWithOptimizations(animalName, vp, "None", nil) end,
        }
        if type(SharedAnimals.AttachOnViewport) == "function" then
            tries[#tries + 1] = function() SharedAnimals:AttachOnViewport(full, vp, "None") end
            tries[#tries + 1] = function() SharedAnimals:AttachOnViewport(full, vp) end
        end
        for _, fn in ipairs(tries) do
            local ok = pcall(fn)
            if ok then
                task.wait(0.1)
                if vp.CurrentCamera or #vp:GetDescendants() > 1 then return true end
            end
        end
    end
    local template = findModelTemplate(full)
    if template and putModelInVP(vp, template) then return true end
    pcall(function()
        local found = nil
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v.Name == full then
                found = v
                break
            end
        end
        if found then putModelInVP(vp, found) end
    end)
    if vp.CurrentCamera or #vp:GetDescendants() > 1 then return true end
    return false
end

local function makeViewport(parent, size, animalName, pos)
    local holder = new("Frame", {
        Size = UDim2.new(0, size, 0, size),
        Position = pos,
        BackgroundColor3 = Color3.fromRGB(8, 8, 8),
        BorderSizePixel = 0,
    }, parent)
    corner(holder, 7)
    stroke(holder, P.line, 1, 0.4)
    local initials = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = string.upper(string.sub(tostring(animalName), 1, 2)),
        Font = Enum.Font.GothamBold,
        TextSize = math.max(10, math.floor(size * 0.38)),
        TextColor3 = P.white,
    }, holder)
    local vp = new("ViewportFrame", {
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.new(0, 1, 0, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(200, 200, 200),
        LightColor = Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-0.35, -1, -0.45),
    }, holder)
    corner(vp, 6)
    enqueueVpBuild(function()
        task.wait(0.05)
        local ok = fillViewport(vp, animalName)
        if ok and initials.Parent then initials.Visible = false end
    end)
    return holder, vp
end

local genSuffix = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }

local function parseOverheadGen(texto)
    local num, suf = tostring(texto or ""):gsub("[%$,/s]", ""):gsub("%s+", ""):match("^([%d%.]+)([KkMmBbTt]?)$")
    num = tonumber(num)
    if not num then
        return nil
    end
    return num * (genSuffix[suf:upper()] or 1)
end

