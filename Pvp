    local mejor, dist = nil, 14
    for _, p in ipairs(debris:GetChildren()) do
        if p.Name == "FastOverheadTemplate" and p:IsA("BasePart") then
            local oh = p:FindFirstChild("AnimalOverhead")
            local nombre = oh and oh:FindFirstChild("DisplayName")
            if nombre and nombre.Text == modelo.Name then
                local d = (p.Position - raiz.Position).Magnitude
                if d < dist then
                    dist = d
                    mejor = oh
                end
            end
        end
    end
    return mejor
end

local function animalGeneration(modelo)
    local raiz = modelo:FindFirstChild("RootPart") or modelo.PrimaryPart or modelo:FindFirstChildWhichIsA("BasePart")
    local data = AnimalsData and AnimalsData[modelo.Name]
    local base = type(data) == "table" and tonumber(data.Generation) or 0
    local oh = raiz and readOverhead(modelo, raiz)

    local mut = modelo:GetAttribute("Mutation") or modelo:GetAttribute("__mutation")
    local mutLabel = oh and oh:FindFirstChild("Mutation")
    if mutLabel and mutLabel.Visible and mutLabel.Text ~= "" then
        mut = mutLabel.Text
    end

    local mult = 1
    if mut and MutationsData and MutationsData[tostring(mut)] then
        mult = mult + (tonumber(MutationsData[tostring(mut)].Modifier) or 0)
    end

    local dormido = false
    for _, hijo in ipairs(modelo:GetChildren()) do
        local t = hijo.Name:match("^_Trait%.(.+)$")
        local info = t and TraitsData and (TraitsData[t] or TraitsData[t:gsub("_", " ")])
        if info then
            if t == "Sleepy" or info.Name == "Sleepy" then
                dormido = true
            else
                mult = mult + (tonumber(info.MultiplierModifier) or 0)
            end
        end
    end

    local calculado = math.round(base * mult * (dormido and 0.5 or 1))
    local texto = oh and oh:FindFirstChild("Generation") and parseOverheadGen(oh.Generation.Text)
    if texto and texto > calculado then
        return texto
    end
    return calculado
end

local function formatGeneration(n)
    if n >= 1e9 then
        return string.format("$%.2fB/s", n / 1e9)
    elseif n >= 1e6 then
        return string.format("$%.2fM/s", n / 1e6)
    elseif n >= 1e3 then
        return string.format("$%.1fK/s", n / 1e3)
    end
    return string.format("$%d/s", math.floor(n))
end

local function plotIsMine(plot)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return false end
    local yb = sign:FindFirstChild("YourBase")
    if yb and yb:IsA("BillboardGui") and yb.Enabled then return true end
    local function esc(x) return (x:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")) end
    local pats = {}
    for _, n in ipairs({ LocalPlayer.Name:lower(), LocalPlayer.DisplayName:lower() }) do
        if n ~= "" then pats[#pats + 1] = "%f[%w_]" .. esc(n) .. "%f[^%w_]" end
    end
    for _, d in ipairs(sign:GetDescendants()) do
        if d:IsA("TextLabel") and d.Visible then
            local gui = d:FindFirstAncestorOfClass("BillboardGui")
            if not gui or gui.Enabled then
                local t = d.Text:lower()
                for _, pt in ipairs(pats) do
                    if t:find(pt) then return true end
                end
            end
        end
    end
    return false
end

local function parseGenNumber(text)
    if not text then return 0 end
    text = tostring(text):gsub(",", ""):gsub("%s", ""):upper()
    local num = text:match("([%d%.]+)")
    if not num then return 0 end
    num = tonumber(num) or 0
    if text:find("T") then return num * 1e12 end
    if text:find("B") then return num * 1e9 end
    if text:find("M") then return num * 1e6 end
    if text:find("K") then return num * 1e3 end
    return num
end

local function genTextFmt(gv)
    gv = tonumber(gv) or 0
    local a = math.abs(gv)
    if a >= 1e12 then return string.format("$%.2fT/s", gv / 1e12)
    elseif a >= 1e9 then return string.format("$%.2fB/s", gv / 1e9)
    elseif a >= 1e6 then return string.format("$%.2fM/s", gv / 1e6)
    elseif a >= 1e3 then return string.format("$%.2fK/s", gv / 1e3) end
    return "$" .. tostring(math.floor(gv + 0.5)) .. "/s"
end

local function readPodium(plot, podium)
    local name, genText, price, mutation, rarity = nil, nil, nil, nil, nil
    local adornee = nil
    for _, d in ipairs(podium:GetDescendants()) do
        pcall(function()
            for _, key in ipairs({ "Mutation", "Mut", "Variant", "Rarity", "Tier", "RarityName", "AnimalName", "Name", "PetName", "Generation", "Value", "Cash", "Price" }) do
                local val = d:GetAttribute(key)
                if val ~= nil and tostring(val) ~= "" then
                    local s = tostring(val)
                    local low = s:lower()
                    if key == "Mutation" or key == "Mut" or key == "Variant" then
                        if not mutation then mutation = s end
                    elseif key == "Rarity" or key == "Tier" or key == "RarityName" then
                        if not rarity then rarity = s end
                    elseif key == "AnimalName" or key == "Name" or key == "PetName" then
                        if not name and not RARITY_WORDS[low] and not MUTATION_WORDS[low] and s ~= "Steal" and s ~= "Buy" then name = s end
                    elseif key == "Generation" or key == "Value" or key == "Cash" or key == "Price" then
                        if not genText then genText = s end
                        price = price or parseGenNumber(s)
                    end
                end
            end
        end)
        if d:IsA("ProximityPrompt") then
            local n = d:GetAttribute("AnimalName") or d:GetAttribute("Name") or d:GetAttribute("PetName") or d.ObjectText
            if n and tostring(n) ~= "" and tostring(n) ~= "Steal" and tostring(n) ~= "Buy" then name = name or tostring(n) end
            if d.Parent and d.Parent:IsA("BasePart") then adornee = d.Parent end
        end
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local tx = tostring(d.Text or "")
            local low = tx:lower():gsub("^%s+", ""):gsub("%s+$", "")
            if tx:find("/s") or (tx:find("%$") and tx:find("%d")) then
                genText = tx
            elseif RARITY_WORDS[low] then
                rarity = rarity or tx
            elseif MUTATION_WORDS[low] then
                mutation = mutation or tx
            elseif #tx > 2 and #tx < 48 and not tx:find("%$") and not tx:find("Steal") and not tx:find("Buy") then
                if not name then name = tx end
            end
        end
    end
    local base = podium:FindFirstChild("Base")
    if base then
        local spawnPart = base:FindFirstChild("Spawn")
        adornee = spawnPart or base:FindFirstChildWhichIsA("BasePart") or adornee
    end
    local animalModel = nil
    if AnimalsData then
        for _, d in ipairs(podium:GetDescendants()) do
            if d:IsA("Model") and AnimalsData[d.Name] then
                animalModel = d
                break
            end
        end
    end
    if animalModel then name = animalModel.Name end
    if not name then return nil end
    local gv = parseGenNumber(genText)
    if animalModel then
        local okGen, calc = pcall(animalGeneration, animalModel)
        if okGen and type(calc) == "number" and calc > 0 then
            gv = calc
            genText = formatGeneration(calc)
            price = calc
        end
    end
    if not genText or genText == "" then genText = genTextFmt(gv) end
    if not rarity or rarity == "" then rarity = "Common" end
    if not mutation or mutation == "" or mutation == "None" then mutation = "Normal" end
    return {
        uid = tostring(plot.Name) .. ":" .. tostring(podium.Name) .. ":" .. tostring(name),
        name = name, petName = name,
        genValue = gv, genText = genText, mpsValue = gv, mpsText = genText,
        mutation = mutation, traits = "", rarity = rarity, owner = "",
        price = price or gv, plot = plot.Name, slot = podium.Name,
        isCarpet = false, _part = adornee,
    }
end

local function sortedPodiums(pods)
    local list = pods:GetChildren()
    table.sort(list, function(a, b)
        local na, nb = tonumber(a.Name), tonumber(b.Name)
        if na and nb then return na < nb end
        return tostring(a.Name) < tostring(b.Name)
    end)
    return list
end

local function scanAnimals()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return end
    local cache = {}
    for _, plot in ipairs(plots:GetChildren()) do
        local pods = (not plotIsMine(plot)) and plot:FindFirstChild("AnimalPodiums")
        if pods then
            for i, podium in ipairs(sortedPodiums(pods)) do
                local row = readPodium(plot, podium)
                if row then
                    row.slot = tonumber(podium.Name) or i
                    row.slotName = podium.Name
                    cache[#cache + 1] = row
                end
            end
        end
    end
    table.sort(cache, function(a, b) return (a.genValue or 0) > (b.genValue or 0) end)
    Shared.AllAnimalsCache = cache
    Shared.notify()
end

local function findAdorneeGlobal(animalData)
    if not animalData then return nil end
    local plots = Workspace:FindFirstChild("Plots")
    local plot = plots and animalData.plot and plots:FindFirstChild(tostring(animalData.plot))
    if not plot then return nil end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    local podium = podiums and animalData.slot and podiums:FindFirstChild(tostring(animalData.slotName or animalData.slot))
    if not podium and podiums then
        local idx = tonumber(animalData.slot)
        if idx then podium = sortedPodiums(podiums)[idx] end
    end
    if not podium then return nil end
    local base = podium:FindFirstChild("Base")
    if not base then return podium:FindFirstChildWhichIsA("BasePart", true) end
    local spawnPart = base:FindFirstChild("Spawn")
    return spawnPart or base:FindFirstChildWhichIsA("BasePart") or base
end

local function espAdornee(data)
    if not data then return nil end
    if data._part and data._part.Parent then return data._part end
    return findAdorneeGlobal(data)
end

