function Aim.legacy()
    if Aim.legacyRemote and Aim.legacyRemote.Parent then return Aim.legacyRemote end
    if Aim.legacyAt and tick() - Aim.legacyAt < 5 then return nil end
    Aim.legacyAt = tick()
    local pk = ReplicatedStorage:FindFirstChild("Packages")
    local net = pk and pk:FindFirstChild("Net")
    local consts = (debug and debug.getconstants) or getconstants
    if not (net and getconnections and consts) then return nil end
    for _, r in ipairs(net:GetChildren()) do
        if r:IsA("RemoteEvent") then
            local ok, list = pcall(getconnections, r.OnClientEvent)
            if ok and type(list) == "table" then
                for _, c in ipairs(list) do
                    if c and type(c.Function) == "function" then
                        local ok2, ks = pcall(consts, c.Function)
                        if ok2 and type(ks) == "table" then
                            for _, k in ipairs(ks) do
                                if k == "PaintballHitted" then
                                    Aim.legacyRemote = r
                                    return r
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

function Aim.fire(pos, part, extra)
    if Aim.remote and Aim.remote.Parent then
        local ok
        if extra then
            ok = pcall(Aim.fireFn, Aim.remote, pos, part, extra)
        else
            ok = pcall(Aim.fireFn, Aim.remote, pos, part)
        end
        if ok then return true end
    end
    local lg = Aim.legacy()
    if lg and pcall(lg.FireServer, lg, pos, part) then return true end
    local resolver = _G._FH_ResolveUseItemRemote
    if type(resolver) == "function" then
        local ok, r = pcall(resolver)
        if ok and r and pcall(r.FireServer, r, pos, part) then return true end
    end
    local r = Aim.map["RE/UseItem"] or Aim.map["UseItem"]
    if r and r.Parent and pcall(r.FireServer, r, pos, part) then return true end
    return false
end

function Aim.equipped()
    local ch = LocalPlayer.Character
    local t = ch and ch:FindFirstChildOfClass("Tool")
    if t and AIM_TOOLS[t.Name] then return t end
    return nil
end

local function aimAlive(ch)
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function aimPart(ch)
    for _, n in ipairs(AIM_PARTS) do
        local p = ch:FindFirstChild(n)
        if p then return p end
    end
    return nil
end

function Aim.target()
    local ch = LocalPlayer.Character
    local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso"))
    if not hrp then return nil end
    local bestPart, bestD = nil, _G.AimbotRange or 800
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and aimAlive(p.Character) then
            local part = aimPart(p.Character)
            if part then
                local d = (part.Position - hrp.Position).Magnitude
                if d < bestD then
                    bestPart, bestD = part, d
                end
            end
        end
    end
    return bestPart
end

function Aim.tracer(a, b)
    pcall(function()
        local len = (b - a).Magnitude
        if len < 0.1 then return end
        local mid = CFrame.new(a, b) * CFrame.new(0, 0, -len / 2)
        local core = new("Part", {
            Name = "SertixLaserTracer", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 255, 255),
            Size = Vector3.new(0.2, 0.2, len), CFrame = mid, Transparency = 0,
        })
        local glow = new("Part", {
            Name = "SertixLaserTracerGlow", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            CastShadow = false, Material = Enum.Material.Neon, Color = Color3.fromRGB(150, 152, 160),
            Size = Vector3.new(0.42, 0.42, len), CFrame = mid, Transparency = 0.4,
        })
        core.Parent = Workspace
        glow.Parent = Workspace
        local info = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, 1.6)
        TweenService:Create(core, info, { Transparency = 1 }):Play()
        TweenService:Create(glow, info, { Transparency = 1 }):Play()
        Debris:AddItem(core, 2.2)
        Debris:AddItem(glow, 2.2)
    end)
end

function Aim.drawTracer(tool, pos)
    pcall(function()
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if not handle then return end
        local m = tool:FindFirstChild("Muzzle", true) or tool:FindFirstChild("FirePoint", true)
            or tool:FindFirstChild("Tip", true) or tool:FindFirstChild("Emitter", true)
            or tool:FindFirstChild("ShootPoint", true)
        local origin = handle.Position
        if m and m:IsA("Attachment") then
            origin = m.WorldPosition
        elseif m and m:IsA("BasePart") then
            origin = m.Position
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = { LocalPlayer.Character, tool }
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then table.insert(filter, bp) end
        params.FilterDescendantsInstances = filter
        params.IgnoreWater = true
        local hit = Workspace:Raycast(origin, pos - origin, params)
        Aim.tracer(origin, hit and hit.Position or pos)
    end)
end

function Aim.shoot(force)
    if not (Aim.enabled or force) then return false end
    local tool = Aim.equipped()
    if not tool then return false end
    local now = tick()
    if not force and now - Aim.last < 0.04 then return false end
    Aim.last = now
    local part = Aim.target()
    if not part then return false end
    local pos = part.Position
    local extra = nil
    if tool.Name == "Web Slinger" then extra = tool:FindFirstChild("Handle") end
    local sent = Aim.fire(pos, part, extra)
    if not sent then
        Aim.scan()
        if not Aim.detecting then
            Aim.detecting = true
            task.spawn(function()
                pcall(Aim.detect)
                Aim.detecting = false
            end)
        end
    end
    if sent and _G.AimbotTracer and tool.Name == "Laser Cape" then Aim.drawTracer(tool, pos) end
    return sent
end

function Aim.hookTool(t)
    if not (t and t:IsA("Tool")) or Aim.hooked[t] then return end
    Aim.hooked[t] = true
    table.insert(Aim.conns, t.Activated:Connect(function() Aim.shoot(false) end))
