local Watch = {
    tiny = { Enabled = false, Conns = {}, Bound = {}, AddConn = nil, LastFire = 0, LastSend = 0 },
    jail = { Enabled = false, Conns = {}, Bound = {}, AddConn = nil, LastFire = 0, LastSend = 0 },
    balloon = { Enabled = false, Conns = {}, Bound = {}, AddConn = nil, LastFire = 0, LastSend = 0 },
}

local function watchHandle(state)
    if not state.Enabled then return end
    local now = tick()
    if now - state.LastFire < 3 then return end
    state.LastFire = now
    safeAutoReset()
end

local function watchBind(obj, state, keyword)
    if not obj:IsA("RemoteEvent") or state.Bound[obj] then return end
    local ok, conn = pcall(function()
        return obj.OnClientEvent:Connect(function(...)
            for _, arg in ipairs({ ... }) do
                if type(arg) == "string" and arg:lower():find(keyword, 1, true) then
                    watchHandle(state)
                    return
                end
            end
        end)
    end)
    if ok and conn then
        table.insert(state.Conns, conn)
        state.Bound[obj] = true
    end
end

local function stopWatcher(state)
    for _, c in ipairs(state.Conns) do pcall(function() c:Disconnect() end) end
    state.Conns = {}
    state.Bound = {}
    if state.AddConn then
        pcall(function() state.AddConn:Disconnect() end)
        state.AddConn = nil
    end
end

local function startWatcher(state, keyword)
    stopWatcher(state)
    state.Enabled = true
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do watchBind(obj, state, keyword) end
    state.AddConn = ReplicatedStorage.DescendantAdded:Connect(function(obj)
        if state.Enabled then watchBind(obj, state, keyword) end
    end)
end

local function setWatcher(name, keyword, on)
    local state = Watch[name]
    if on then
        startWatcher(state, keyword)
    else
        state.Enabled = false
        stopWatcher(state)
    end
end

local Guard = { ragConns = {}, ragOn = false, jumpConns = {}, jumpOn = false }

local function removeRagdollConstraints(char)
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BallSocketConstraint") or d:IsA("HingeConstraint") or d:IsA("NoCollisionConstraint")
            or (d:IsA("Attachment") and d.Name:find("RagdollAttachment")) then
            pcall(function() d:Destroy() end)
        end
    end
end

function Guard.bindRagdoll(c)
    local humanoid = c:WaitForChild("Humanoid")
    local root = c:WaitForChild("HumanoidRootPart")
    local animator = humanoid:WaitForChild("Animator")
    local lastVel = Vector3.new(0, 0, 0)
    local lastClean = 0
    local isRag = false
    local function isRagState()
        local s = humanoid:GetState()
        return s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.Ragdoll
            or s == Enum.HumanoidStateType.FallingDown or s == Enum.HumanoidStateType.GettingUp
    end
    local function cleanRag()
        local now = tick()
        if now - lastClean < 0.15 then return end
        lastClean = now
        for _, obj in pairs(c:GetDescendants()) do
            if obj:IsA("BallSocketConstraint") or obj:IsA("NoCollisionConstraint") or obj:IsA("HingeConstraint")
                or (obj:IsA("Attachment") and (obj.Name == "A" or obj.Name == "B")) then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyGyro") then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("Motor6D") then
                obj.Enabled = true
            end
        end
        removeRagdollConstraints(c)
        for _, t in pairs(animator:GetPlayingAnimationTracks()) do
            local n = t.Animation and t.Animation.Name:lower() or ""
            if n:find("rag") or n:find("fall") or n:find("hurt") or n:find("down") then
                pcall(function() t:Stop(0) end)
            end
        end
    end
    local function reEnableControls()
        pcall(function()
            require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls():Enable()
        end)
    end
    local function advancedReset()
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("Motor6D") then obj.Enabled = true end
        end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        humanoid.PlatformStand = false
        humanoid.Sit = false
        if humanoid.Health > 0 then humanoid:ChangeState(Enum.HumanoidStateType.Running) end
        Workspace.CurrentCamera.CameraSubject = humanoid
    end
    table.insert(Guard.ragConns, humanoid.StateChanged:Connect(function()
        if not Guard.ragOn then return end
        if isRagState() then
            isRag = true
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
            cleanRag()
            Workspace.CurrentCamera.CameraSubject = humanoid
            reEnableControls()
        else
            isRag = false
        end
    end))
    table.insert(Guard.ragConns, humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if not Guard.ragOn then return end
        if humanoid.PlatformStand then
            task.defer(function()
                if not Guard.ragOn then return end
                advancedReset()
                removeRagdollConstraints(c)
            end)
        end
    end))
    table.insert(Guard.ragConns, RunService.Heartbeat:Connect(function()
        if not Guard.ragOn then return end
        local endT = LocalPlayer:GetAttribute("RagdollEndTime")
        if endT and (endT - Workspace:GetServerTimeNow()) > 0 then isRag = true end
        if isRag then
            cleanRag()
            local vel = root.AssemblyLinearVelocity
            if (vel - lastVel).Magnitude > 40 and vel.Magnitude > 25 then
                root.AssemblyLinearVelocity = vel.Unit * math.min(vel.Magnitude, 15)
            end
            lastVel = vel
            if humanoid.PlatformStand then advancedReset() end
        end
    end))
    reEnableControls()
    cleanRag()
end

function Guard.stopRagdoll()
    Guard.ragOn = false
    for _, c in pairs(Guard.ragConns) do pcall(function() c:Disconnect() end) end
    Guard.ragConns = {}
    pcall(function()
        local c = LocalPlayer.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        end
    end)
end

function Guard.startRagdoll()
    Guard.stopRagdoll()
    Guard.ragOn = true
    task.spawn(function()
        local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        Guard.bindRagdoll(c)
    end)
    table.insert(Guard.ragConns, LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.spawn(function()
            if Guard.ragOn then Guard.bindRagdoll(newChar) end
        end)
    end))
end

function Guard.stopJump()
    Guard.jumpOn = false
    for _, c in pairs(Guard.jumpConns) do pcall(function() c:Disconnect() end) end
    Guard.jumpConns = {}
end

function Guard.startJump()
    Guard.stopJump()
    Guard.jumpOn = true
    local function boost(requireSpace)
        local c = LocalPlayer.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        local st = hum:GetState()
        if requireSpace then
            if not (UserInputService:IsKeyDown(Enum.KeyCode.Space) and st == Enum.HumanoidStateType.Freefall) then return end
        elseif st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Jumping then
            return
        end
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
    end
    table.insert(Guard.jumpConns, UserInputService.JumpRequest:Connect(function()
        if Guard.jumpOn then boost(false) end
    end))
    table.insert(Guard.jumpConns, RunService.Heartbeat:Connect(function()
        if Guard.jumpOn then boost(true) end
    end))
end

local function findTool(name)
    if not Character then return nil end
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(name:lower()) then return tool end
    end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(name:lower()) then return tool end
    end
    return nil
end

local function getSelectedGearTool()
    local choice = (_G.SelectedGear or "Flying Carpet"):lower()
    local order
    if choice:find("broom") then order = { "broom", "witch" }
    elseif choice:find("sleigh") then order = { "sleigh", "santa" }
    elseif choice:find("wings") then order = { "wings", "cupid" }
    elseif choice:find("wave") then order = { "waverider", "wave rider", "wave" }
    elseif choice:find("bee") then order = { "flying bee", "bee" }
    else order = { "flying carpet", "magic carpet", "rainbow carpet", "carpet" } end
    for _, kw in ipairs(order) do
        local t = findTool(kw)
        if t then return t end
    end
    return nil
end

