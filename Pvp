    local function sliderRow(parent, titleText, desc, minVal, maxVal, key, onUpdate, editable)
        local row = rowBase(parent, 60)
        new("TextLabel", { Size = UDim2.new(1, -60, 0, 18), Position = UDim2.new(0, 12, 0, 6), BackgroundTransparency = 1, Text = titleText, TextColor3 = P.white, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 16 }, row)
        local badgeProps = {
            Size = UDim2.new(0, 40, 0, 18), Position = UDim2.new(1, -52, 0, 6),
            BackgroundColor3 = P.panel, BorderSizePixel = 0, TextColor3 = P.white,
            TextSize = 10, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 16,
        }
        if editable then
            badgeProps.ClearTextOnFocus = false
            badgeProps.PlaceholderText = tostring(minVal)
        end
        local badge = new(editable and "TextBox" or "TextLabel", badgeProps, row)
        corner(badge, 4)
        stroke(badge, P.lineDim, 1)
        
        local trackF = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 44), BackgroundColor3 = P.trackOff, BorderSizePixel = 0, ZIndex = 16 }, row)
        corner(trackF, 3)
        local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = P.accent, BorderSizePixel = 0, ZIndex = 17 }, trackF)
        corner(fill, 3)
        local knob = new("Frame", { Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = P.white, BorderSizePixel = 0, ZIndex = 18 }, trackF)
        corner(knob, 6)

        local function paint(val)
            local pct = math.clamp((val - minVal) / (maxVal - minVal), 0, 1)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            badge.Text = tostring(math.floor(val))
        end
        paint(_G[key] or minVal)

        local dragging = false
        local function fromX(x)
            local rel = math.clamp((x - trackF.AbsolutePosition.X) / math.max(trackF.AbsoluteSize.X, 1), 0, 1)
            local val = math.floor(minVal + rel * (maxVal - minVal) + 0.5)
            _G[key] = val
            paint(val)
            if onUpdate then pcall(onUpdate, val) end
        end
        if editable then
            badge.FocusLost:Connect(function()
                local parsed = tonumber(tostring(badge.Text):gsub("%%", ""))
                if not parsed then
                    paint(_G[key] or minVal)
                    return
                end
                local val = math.clamp(math.floor(parsed + 0.5), minVal, maxVal)
                _G[key] = val
                paint(val)
                if onUpdate then pcall(onUpdate, val) end
                saveSettings()
            end)
        end
        local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, -9), BackgroundTransparency = 1, Text = "", ZIndex = 18 }, trackF)
        hit.InputBegan:Connect(function(inp) if isPointer(inp) then dragging = true fromX(inp.Position.X) end end)
        track(UserInputService.InputChanged:Connect(function(inp) if dragging and isMove(inp) then fromX(inp.Position.X) end end))
        track(UserInputService.InputEnded:Connect(function(inp) if dragging and isPointer(inp) then dragging = false saveSettings() end end))
    end

