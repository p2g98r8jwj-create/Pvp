    local function toggleRow(parent, titleText, desc, key, onToggle)
        local row = rowBase(parent, 52)
        new("TextLabel", { Size = UDim2.new(1, -70, 0, 18), Position = UDim2.new(0, 12, 0, 8), BackgroundTransparency = 1, Text = titleText, TextColor3 = P.white, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 16 }, row)
        new("TextLabel", { Size = UDim2.new(1, -70, 0, 22), Position = UDim2.new(0, 12, 0, 26), BackgroundTransparency = 1, Text = desc, TextColor3 = P.dim, TextSize = 9, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 16 }, row)

        local trackF = new("Frame", { Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -48, 0.5, -9), BackgroundColor3 = P.trackOff, BorderSizePixel = 0, ZIndex = 16 }, row)
        corner(trackF, 9)
        local ts = stroke(trackF, P.line, 1, 0.5)
        local knob = new("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 4, 0.5, -6), BackgroundColor3 = P.knobOff, BorderSizePixel = 0, ZIndex = 17 }, trackF)
        corner(knob, 6)

        local function render(animate)
            local on = _G[key] and true or false
            local t = animate and 0.14 or 0
            if on then
                tween(trackF, t, { BackgroundColor3 = P.accent })
                tween(ts, t, { Color = P.accent, Transparency = 0.5 })
                tween(knob, t, { Position = UDim2.new(0, 20, 0.5, -6), BackgroundColor3 = Color3.fromRGB(20, 20, 20) })
            else
                tween(trackF, t, { BackgroundColor3 = P.trackOff })
                tween(ts, t, { Color = P.line, Transparency = 0.5 })
                tween(knob, t, { Position = UDim2.new(0, 4, 0.5, -6), BackgroundColor3 = P.knobOff })
            end
        end
        render(false)
        if onToggle then task.defer(function() pcall(onToggle, _G[key] and true or false) end) end

        local hit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 18 }, row)
        hit.MouseButton1Click:Connect(function()
            _G[key] = not _G[key]
