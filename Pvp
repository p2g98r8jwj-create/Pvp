local function waitForLanding(hum, timeout)
    timeout = timeout or 2.0
    local start = tick()
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.Running then return true end
    local landed = false
    local conn = hum.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then
            landed = true
        end
    end)
    while not landed and (tick() - start) < timeout do
        task.wait(0.02)
        if not hum or not hum.Parent or hum.Health <= 0 then break end
    end
    if conn then conn:Disconnect() end
    return landed
end

local function startTripToPetSlot(prompt, slotNumber)
    if not slotNumber then return end
    local livePrompt = prompt
    if not livePrompt or not livePrompt.Parent or not livePrompt.Enabled then
        livePrompt = resolveLivePrompt(Sel.plot, slotNumber)
    end
    if not livePrompt or not livePrompt.Parent then
        local entry = BrainrotList.entries[tostring(Sel.plot) .. "_" .. tostring(slotNumber)]
        if entry and entry.prompt and entry.prompt.Parent then livePrompt = entry.prompt end
    end
    if not livePrompt or not livePrompt.Parent then return end

    MyBaseSide = getMyBaseSide()
    local coords = SlotsCoords[MyBaseSide == "b2" and "b2" or "b1"]
    local config = coords[slotNumber] or coords[1]
    if MyBaseSide == "b2" and slotNumber == 28 then return end
    local targetPositions = config.Positions
    local needJump = config.NeedJump == true
    if slotNumber == 28 then needJump = true end
    if not Root or not Humanoid then return end
    if type(_G.SertixForceUnlock) == "function" then _G.SertixForceUnlock() end

    Sel.auto = true
    local Speed = 174
    local grabStartDistance = 60
    local grabStarted = false
    local savedWS, savedJP = Humanoid.WalkSpeed, Humanoid.JumpPower
    Humanoid.WalkSpeed = 0
    Humanoid.JumpPower = 0
    Humanoid.AutoRotate = false
    local animator = Humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop(0) end)
        end
    end
    local function restoreMovement()
        Humanoid.WalkSpeed = savedWS
        Humanoid.JumpPower = savedJP
        Humanoid.AutoRotate = true
    end
    local gear = getSelectedGearTool()
    if gear then
        Humanoid:UnequipTools()
        task.wait(0.03)
        Humanoid:EquipTool(gear)
    end
    if Root:FindFirstChild("LinearVelocity") then Root.LinearVelocity:Destroy() end
    if Root:FindFirstChild("Attachment") then Root.Attachment:Destroy() end

    local Attachment = Instance.new("Attachment")
    Attachment.Parent = Root
    local Velocity = Instance.new("LinearVelocity")
    Velocity.Attachment0 = Attachment
    Velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    Velocity.MaxForce = math.huge
    Velocity.Parent = Root

    local currentPosIndex = 1
    local pausing = false
    local wpStart = tick()
    local movementConn

    movementConn = RunService.Heartbeat:Connect(function()
        if thisScriptStopped or not Root or not Humanoid or not Root.Parent or Humanoid.Health <= 0 then
            if movementConn then movementConn:Disconnect() end
            restoreMovement()
            return
        end
        if pausing then
            Velocity.VectorVelocity = Vector3.zero
            return
        end
        if not livePrompt or not livePrompt.Parent or not livePrompt.Enabled then
            local re = resolveLivePrompt(Sel.plot, slotNumber)
            if re then livePrompt = re end
        end
        local Target = targetPositions[currentPosIndex]
        if not Target then return end
        local rootPos = Root.Position
        local dir = Vector3.new(Target.X - rootPos.X, 0, Target.Z - rootPos.Z)
        local dist = dir.Magnitude
        local finalPos = targetPositions[#targetPositions]
        local finalDist = Vector3.new(finalPos.X - rootPos.X, 0, finalPos.Z - rootPos.Z).Magnitude
        
        if finalDist <= grabStartDistance and not grabStarted then
            grabStarted = true
            showAutoGrab()
        end
        
        local dyT = Target.Y - rootPos.Y
        local heightOk = math.abs(dyT) <= 3 or tick() - wpStart > 4

        if dist <= STOP_DIST and heightOk then
            if currentPosIndex < #targetPositions then
                pausing = true
                Velocity.VectorVelocity = Vector3.zero
                Root.AssemblyLinearVelocity = Vector3.zero
                task.spawn(function()
                    currentPosIndex = currentPosIndex + 1
                    wpStart = tick()
                    pausing = false
                end)
                return
            end
            Velocity.VectorVelocity = Vector3.zero
            Root.AssemblyLinearVelocity = Vector3.zero
            Velocity:Destroy()
            Attachment:Destroy()
            Root.CFrame = CFrame.new(Target)
            if movementConn then movementConn:Disconnect() end

            local cam = Workspace.CurrentCamera
            task.wait(0.12)
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = config.FixedCFrame or (CFrame.new(Root.Position + config.CamOffset) * CFrame.Angles(unpack(config.CamAngles)))
            Humanoid:UnequipTools()
            task.wait(0.08)

            if needJump then
                Root.AssemblyLinearVelocity = Vector3.new(0, 55, 0)
                waitForLanding(Humanoid, 2.0)
            end

            task.spawn(function() executeSteal(livePrompt) end)
            
            if _G.PingBypass and slotNumber <= 18 then
                local t = getNearestPlayer()
                if t then blockPlayer(t, true) end
                task.wait(0.4)
            elseif _G.PreBlock or _G.AutoBlock then
                local t = getNearestPlayer()
                if t then blockPlayer(t, true) end
                if _G.PreBlock then task.wait(preBlockLeadForSlot(slotNumber)) end
            end

            local flash = findTool("flash")
            if flash then
                Humanoid:EquipTool(flash)
                task.wait(0.14)
                flash:Activate()
            end

            task.wait(0.1)
            if _G.AutoGiant then
                local giant = findTool("giant potion")
                if giant then
                    Humanoid:UnequipTools()
                    task.wait(0.04)
                    Humanoid:EquipTool(giant)
                    task.wait(0.08)
                    giant:Activate()
                    task.wait(0.05)
                    if _G.RagdollBypass then
                        task.spawn(function() ExecuteCommand("ragdoll", LocalPlayer.Name) end)
                    end
                    Humanoid:UnequipTools()
                end
            end
            cam.CameraType = Enum.CameraType.Custom

            task.spawn(function()
                task.wait(1.0)
                Sel.auto = false
            end)
            restoreMovement()
            return
        end
        local hx, hz = 0, 0
        if dist > STOP_DIST then
            hx, hz = dir.Unit.X * Speed, dir.Unit.Z * Speed
        end
        local vy = 0
        if math.abs(dyT) > 0.75 then
            vy = math.clamp(dyT * 6, -Speed, Speed)
        end
        Velocity.VectorVelocity = Vector3.new(hx, vy, hz)
    end)
end

