local function destroyEntry(tbl, key)
    local entry = tbl[key]
    if entry and entry.bb then pcall(function() entry.bb:Destroy() end) end
    tbl[key] = nil
end

function Esp.refreshBrainrot()
    if not _G.BrainrotEspV2 then
        for uid in pairs(Esp.cards) do destroyEntry(Esp.cards, uid) end
        return
    end
    local scale = _G.EspScale or 100
    if scale ~= Esp.lastScale then
        Esp.lastScale = scale
        for uid in pairs(Esp.cards) do destroyEntry(Esp.cards, uid) end
    end
    local cache = Shared.AllAnimalsCache
    if not cache or #cache == 0 then return end
    local bestUid = Shared.SelectedPetData and Shared.SelectedPetData.uid
    local seen, shown = {}, 0
    for _, data in ipairs(cache) do
        local isBest = data.uid and data.uid == bestUid
        local wanted = isBest or shown < BR_ESP_MAX
        if data.uid and wanted then
            if not isBest then shown = shown + 1 end
            seen[data.uid] = true
            local entry = Esp.cards[data.uid]
            local sig = espSig(data)
            if entry and (not entry.bb or not entry.bb.Parent or entry.sig ~= sig) then
                destroyEntry(Esp.cards, data.uid)
                entry = nil
            end
            if not entry then
                local adornee = espAdornee(data)
                if adornee then
                    local bb, distLabel = Esp.buildCard(data)
                    bb.Adornee = adornee
                    bb.Parent = GUI_HOST
                    entry = { bb = bb, distLabel = distLabel, sig = sig }
                    Esp.cards[data.uid] = entry
                end
            end
            if entry and entry.distLabel then entry.distLabel.Text = espDistanceTo(data) .. "m" end
        end
    end
    for uid in pairs(Esp.cards) do
        if not seen[uid] then destroyEntry(Esp.cards, uid) end
    end
end
Shared.onList(function() pcall(Esp.refreshBrainrot) end)

