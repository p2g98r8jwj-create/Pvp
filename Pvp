    local function qapTimer(cmdName)
        local ok, sf = pcall(function() return PlayerGui.AdminPanel.AdminPanel.Content.ScrollingFrame end)
        if not ok or not sf then return nil end
        local item = sf:FindFirstChild(cmdName)
        local tm = item and item:FindFirstChild("Timer")
        if tm and tm.Visible then return tm.Text end
        return nil
    end

    local function executeQapCommand(cmdName, plrName)
        local cmd = cmdName:lower()
        task.spawn(function()
            -- Try admin panel first
            local okPanel, adminPanel = pcall(function() return PlayerGui.AdminPanel end)
            if okPanel and adminPanel then
                local ap = adminPanel:FindFirstChild("AdminPanel")
                local content = ap and ap:FindFirstChild("Content")
                local sf = content and content:FindFirstChild("ScrollingFrame")
                if sf then
                    local item = sf:FindFirstChild(cmdName)
                    if item then
                        local btn = item:FindFirstChild("TextButton")
                        if btn then
                            -- Set target player textbox
                            local tb = item:FindFirstChildOfClass("TextBox")
                            if tb then tb.Text = plrName end
                            firetouchinterest = firetouchinterest or function() end
                            local vim = VirtualInputManager or Instance.new("VirtualInputManager")
                            local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
                            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                            return
                        end
                    end
                end
            end
            -- Fallback to executor command
            if type(ExecuteCommand) == "function" then
                pcall(ExecuteCommand, cmdName, plrName)
            end
        end)
    end

    local function qapMakeRow(plr, ord)
